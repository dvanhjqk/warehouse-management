# ==========================================
# CẤU HÌNH KẾT NỐI SUPABASE POSTGRESQL
# ==========================================

# 1. Transaction Pooler URL (Dùng cho Prisma Client truy vấn trong ứng dụng Serverless / Vercel)
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection URL (Dùng cho Prisma CLI: db push, migrate, seed - Port 5432)
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session hoặc Direct - Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Môi trường chạy
NODE_ENV="development"
